AWS_PROFILE=lab
AWS_REGION=ap-northeast-2
EXPECTED_ACCOUNT_ID=123456789012
# 앱 고정 토큰. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=change-me
# 시작·중지를 허용할 EC2 인스턴스 ID (쉼표로 구분)
ALLOWED_INSTANCE_IDS=i-0123456789abcdef0,i-0fedcba9876543210
# MariaDB (init_db와 서버가 사용)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_control
DB_USER=cloud_control
DB_PASSWORD=change-me
